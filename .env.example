# Tokenni BotFather orqali olasiz. Uni hech kimga yubormang.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# /id komandasi chiqargan raqam. Bir nechta admin: 123,456
ADMIN_IDS=
# Ixtiyoriy: SQLite ma'lumotlar bazasi fayli
DATABASE_PATH=data/olimpiada.sqlite3
# Yangi Groq API kalitini https://console.groq.com/keys orqali yarating.
# Buni hech qachon chatga yoki GitHubga joylamang.
GROQ_API_KEY=YOUR_NEW_GROQ_API_KEY
# Render: copy the Internal Database URL from the PostgreSQL Connect menu.
DATABASE_URL=
# Generated for you on Render. Keep private.
WEBHOOK_SECRET=
# Normally filled automatically by Render through RENDER_EXTERNAL_URL.
WEBHOOK_BASE_URL=
